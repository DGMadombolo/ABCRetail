@model IEnumerable<ABCRetail.Models.ProductImage>

@{
    ViewData["Title"] = "Product Images";
}

<div class="container mt-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold">Product Images</h1>

            <p class="text-muted mb-0">
                Images stored securely in Azure Blob Storage
            </p>
        </div>

        <a asp-controller="Products"
           asp-action="Upload"
           class="btn btn-primary">
            + Upload Image
        </a>

    </div>


    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }


    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var image in Model)
            {
                <div class="col-sm-6 col-md-4 col-lg-3">

                    <div class="card product-card h-100 shadow-sm">

                        <!-- Image -->
                        <div class="product-image-container">

                            <img src="@image.ImageUrl"
                                 alt="@image.FileName"
                                 class="product-image"
                                 loading="lazy" />

                        </div>


                        <!-- Information -->
                        <div class="card-body">

                            <h6 class="card-title text-truncate"
                                title="@image.FileName">

                                @image.FileName

                            </h6>

                            <p class="text-muted small mb-0">

                                Uploaded:
                                @image.UploadedAt.ToString(
                                    "dd/MM/yyyy HH:mm")

                            </p>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="alert alert-info text-center">

            <h5>No Product Images</h5>

            <p class="mb-0">
                Upload your first product image to Azure Blob Storage.
            </p>

        </div>
    }

</div>