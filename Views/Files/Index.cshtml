@model IEnumerable<ABCRetail.Models.StoredFile>

@{
    ViewData["Title"] = "Files";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Stored Files</h1>

            <p class="text-muted">
                Files stored in Azure File Storage
            </p>
        </div>

        <a asp-controller="Files"
           asp-action="Upload"
           class="btn btn-primary">
            + Upload File
        </a>

    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover">

                <thead class="table-dark">

                    <tr>
                        <th>File Name</th>
                        <th>Size</th>
                        <th>Uploaded</th>
                        <th>Action</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var file in Model)
                    {
                        <tr>

                            <td>
                                @file.FileName
                            </td>

                            <td>
                                @($"{file.FileSize / 1024.0:F2} KB")
                            </td>

                            <td>
                                @file.UploadedAt.ToString(
                                    "dd/MM/yyyy HH:mm")
                            </td>

                            <td>

                                <a asp-controller="Files"
                                   asp-action="Download"
                                   asp-route-fileName="@file.FileName"
                                   class="btn btn-sm btn-success">
                                    Download
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="alert alert-info">
            No files have been uploaded yet.
        </div>
    }

</div>